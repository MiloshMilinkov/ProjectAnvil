{
  "name": "projectanvil",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/build-app.mjs",
    "start": "node scripts/start-built.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "test": "node scripts/check-backend.mjs && node --test tests/local-backup.test.mjs tests/pwa.test.mjs tests/build-fingerprint.test.mjs tests/test-runtime.test.mjs",
    "test:browser": "node scripts/run-browser-tests.mjs",
    "test:performance": "node scripts/run-performance-tests.mjs",
    "size:report": "node scripts/report-size.mjs",
    "check": "tsc --noEmit --incremental false && npm run lint -- --max-warnings 0 && npm test && npm run build",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "backup:create": "node scripts/local-backup.mjs create",
    "backup:verify": "node scripts/local-backup.mjs verify",
    "backup:restore": "node scripts/local-backup.mjs restore",
    "account-mail": "node scripts/account-mail.mjs",
    "db:migrations:plan": "node --experimental-strip-types scripts/database-migrations.mjs"
  },
  "dependencies": {
    "better-auth": "1.7.11",
    "drizzle-orm": "0.45.2",
    "fflate": "0.8.3",
    "highlight.js": "11.11.2",
    "katex": "0.19.0",
    "lucide-react": "^1.31.0",
    "mermaid": "^12.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "yjs": "13.6.33",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/mdast": "4.0.4",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.37",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "14.0.0",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.3.1",
    "vite": "8.1.6",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "unrs-resolver@1.11.1": true,
    "workerd@1.20260515.1": true
  },
  "overrides": {
    "sharp": "0.35.5",
    "ws": "8.21.0",
    "undici": "7.30.1",
    "source-map-js": "1.2.2",
    "fast-uri": "3.1.9",
    "baseline-browser-mapping": "2.11.0",
    "image-size": "2.0.3",
    "browserslist": "4.28.7",
    "@babel/core": "7.29.6",
    "fflate": "0.8.3",
    "js-yaml": "4.3.2",
    "katex": "$katex",
    "brace-expansion@^1.0.0": "1.1.21",
    "brace-expansion@^5.0.0": "5.0.12",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "esbuild@>=0.27.3 <0.28.1": "0.28.1"
  }
}
