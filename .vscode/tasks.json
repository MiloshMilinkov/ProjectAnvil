{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Check ProjectAnvil",
      "type": "npm",
      "script": "check",
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Run ProjectAnvil",
      "type": "process",
      "command": "node",
      "args": ["scripts/start-local.mjs"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Check ProjectAnvil types",
      "type": "process",
      "command": "node",
      "args": ["node_modules/typescript/bin/tsc", "--noEmit"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": "$tsc",
      "group": "test"
    },
    {
      "label": "Test ProjectAnvil storage",
      "type": "process",
      "command": "node",
      "args": ["scripts/check-backend.mjs"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Build ProjectAnvil",
      "type": "process",
      "command": "node",
      "args": ["scripts/build-app.mjs"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
